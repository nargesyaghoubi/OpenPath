    "about": {
        "title": "About OpenPath",
        "mission": {
            "title": "Our Mission",
            "text": "OpenPath is a free, open platform dedicated to connecting people everywhere with life-changing opportunities — jobs, scholarships, internships, remote work, and training programs — regardless of where they live or come from."
        },
        "problem": {
            "title": "The Problem We Solve",
            "text": "Opportunities are scattered across hundreds of websites, social media groups, and email newsletters. People — especially those in underserved regions — miss critical deadlines simply because they don't know where to look."
        },
        "solution": {
            "title": "Our Solution",
            "text": "OpenPath centralises verified global opportunities in a clean, fast, and mobile-friendly platform. Users can search, filter by country, save and apply — in multiple languages — from any device."
