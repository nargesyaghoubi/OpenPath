    "about": {
        "title": "Acerca de OpenPath",
        "mission": {
            "title": "Nuestra misión",
            "text": "OpenPath es una plataforma gratuita y abierta que conecta a personas de todo el mundo con oportunidades que cambian vidas: empleos, becas, pasantías, trabajo remoto y programas de capacitación, todo en un solo lugar accesible."
        },
        "problem": {
            "title": "El problema que resolvemos",
            "text": "En todo el mundo, la información sobre oportunidades suele estar dispersa entre redes sociales, aplicaciones de mensajería y numerosos sitios web. Muchas personas pierden oportunidades valiosas simplemente porque no saben dónde buscarlas."
        },
        "solution": {
            "title": "Nuestra solución",
            "text": "OpenPath centraliza oportunidades verificadas en una plataforma rápida, intuitiva y adaptada a dispositivos móviles. Los usuarios pueden buscar, filtrar, guardar y postular en varios idiomas desde cualquier dispositivo."
        },
        "values": {
            "title": "Nuestros valores",
            "access": "Acceso igual",
            "accessText": "Toda persona merece conocer las oportunidades disponibles para ella..",
            "inclusion": "Inclusión",
            "inclusionText": "Priorizamos a mujeres, jóvenes en provincias y comunidades subrepresentadas.",
            "transparency": "Transparencia",
            "transparencyText": "Todos los datos en la plataforma están claramente etiquetados — reales o de demostración."
        },
        "demoNote": "Este proyecto fue construido como proyecto final. Todos los datos actuales son datos de demostración con fines educativos."
    },
