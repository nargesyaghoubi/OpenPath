# PostgreSQL connection strings (Neon: get these from your Neon project's
# "Connect" panel — Vercel's Neon integration sets these automatically
# when you link the integration to your project).
#
# DATABASE_URL: pooled connection, used by the running app (has "-pooler" in
# the Neon host name, or add "?pgbouncer=true").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DIRECT_URL: unpooled connection, used only for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"

# Optional: only needed if you use the Resend email integration already in
# the project's dependencies.
RESEND_API_KEY=""
